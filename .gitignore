# Generated by the golden mk's lint target. Committing it means every lint
# run dirties the tree and blocks comment-gate, which diffs COMMITTED work.
.golangci.merged.yml

# Fetched from pipeline-catalog by fetch-mk. It is a cache of a remote file,
# never a source of truth — refresh-mk deletes it deliberately.
.leartech-go.mk

# Coverage profiles. A tracked cover.out put leartech-maestro-service#27 at
# 1.07MB and every ai-review model rejected the diff on context length, so the
# PR was scored 0/100 having never been read.
cover.out
coverage.out
coverage.html
build/
